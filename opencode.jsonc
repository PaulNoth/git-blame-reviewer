{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5",
  "instructions": ["AGENTS.md"],
  "agent": {
    "build": { "variant": "medium" },
    "plan": { "variant": "medium" },
    "general": { "variant": "medium" }
  },
  "permission": {
    "bash": {
      "make *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "*": "ask"
    }
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"]
}
